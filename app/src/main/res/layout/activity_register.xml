<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/screen_register_bg"
        android:contentDescription="@string/logo_desc" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_input_exact"
        android:drawableEnd="@android:drawable/ic_menu_myplaces"
        android:drawableTint="@color/theme_header_mid"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|end"
        android:hint="اسم المستخدم"
        android:inputType="textPersonName"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/theme_header_deep"
        android:textColorHint="#9AAFC4"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.068"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.372"
        app:layout_constraintWidth_percent="0.84" />

    <EditText
        android:id="@+id/etMobile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_input_exact"
        android:drawableEnd="@android:drawable/ic_menu_call"
        android:drawableTint="@color/theme_header_mid"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|end"
        android:hint="رقم الجوال"
        android:inputType="phone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/theme_header_deep"
        android:textColorHint="#9AAFC4"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.068"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.462"
        app:layout_constraintWidth_percent="0.84" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_input_exact"
        android:drawableEnd="@android:drawable/ic_lock_idle_lock"
        android:drawableTint="@color/theme_header_mid"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|end"
        android:hint="كلمة المرور"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/theme_header_deep"
        android:textColorHint="#9AAFC4"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.068"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.552"
        app:layout_constraintWidth_percent="0.84" />

    <View
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.07"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.645"
        app:layout_constraintWidth_percent="0.84" />

</androidx.constraintlayout.widget.ConstraintLayout>
