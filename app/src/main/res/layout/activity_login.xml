<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/teable_page_bg"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_teable_card"
        android:elevation="8dp"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo_glow" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_court_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/logo_desc" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="محكمة البيضاء الابتدائية"
                android:textColor="@color/teable_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="تسجيل الدخول"
                android:textColor="@color/teable_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="مرحبًا بعودتك إلى نظام الخدمات الإلكترونية"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etIdentifier"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:hint="اسم المستخدم أو رقم الجوال"
                android:background="@drawable/bg_input_exact"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawableTint="@color/teable_primary"
                android:drawablePadding="8dp"
                android:textColor="@color/teable_input_text"
                android:textColorHint="@color/teable_input_hint"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="كلمة المرور"
                    android:background="@drawable/bg_input_exact"
                    android:paddingStart="14dp"
                    android:paddingEnd="42dp"
                    android:inputType="textPassword"
                    android:drawableStart="@android:drawable/ic_lock_idle_lock"
                    android:drawableTint="@color/teable_primary"
                    android:drawablePadding="8dp"
                    android:textColor="@color/teable_input_text"
                    android:textColorHint="@color/teable_input_hint"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivEye"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="إظهار كلمة المرور" />
            </FrameLayout>

            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="حفظ بيانات الدخول على هذا الجهاز"
                android:textColor="@color/teable_text"
                android:textSize="12sp"
                android:buttonTint="@color/teable_primary" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="دخول"
                android:textColor="@color/teable_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_gold"
                app:backgroundTint="@null" />



            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="إنشاء حساب جديد"
                android:textColor="@color/teable_link"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_teable_footer"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تقنية معلومات محكمة البيضاء الابتدائية"
                android:textColor="@color/teable_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تصميم وبرمجة"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="م/احمد حسين محسون"
                android:textColor="@color/teable_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="771421919 - 734840710"
                android:textColor="@color/teable_link"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
