<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <!-- الصورة الأصلية للثيم كما هي تماماً -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:scaleType="fitXY"
        android:src="@drawable/screen_login_bg"
        android:contentDescription="@string/logo_desc" />

    <!-- حقول الإدخال فوق الصورة بنفس المواقع -->
    <EditText
        android:id="@+id/etIdentifier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_input_exact"
        android:drawableEnd="@android:drawable/ic_dialog_email"
        android:drawableTint="@color/theme_header_mid"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|end"
        android:hint="اسم المستخدم أو رقم الجوال"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/theme_header_deep"
        android:textColorHint="#9AAFC4"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.068"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.365"
        app:layout_constraintWidth_percent="0.84" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_input_exact"
        android:drawableEnd="@android:drawable/ic_lock_idle_lock"
        android:drawableTint="@color/theme_header_mid"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|end"
        android:hint="كلمة المرور"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/theme_header_deep"
        android:textColorHint="#9AAFC4"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.068"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.455"
        app:layout_constraintWidth_percent="0.84" />

    <ImageView
        android:id="@+id/ivEye"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:alpha="0"
        android:clickable="true"
        android:contentDescription="إظهار كلمة المرور"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.455" />

    <!-- زر دخول: الصورة الذهبية تظهر كما هي، وهذه طبقة ضغط شفافة -->
    <View
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.068"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.548"
        app:layout_constraintWidth_percent="0.84" />

    <TextView
        android:id="@+id/tvRegister"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.70"
        app:layout_constraintWidth_percent="0.7" />

    <!-- elementos مخفية عطل عليها الكود الحالي -->
    <CheckBox
        android:id="@+id/cbRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnBiometric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
