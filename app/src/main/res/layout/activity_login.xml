<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animation="@anim/logo_pulse"
                android:background="@drawable/bg_logo_glow" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animation="@anim/logo_pulse"
                android:src="@drawable/ic_court_logo"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/logo_desc" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="محكمة البيضاء الابتدائية"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تسجيل الدخول"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/gold_light"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etIdentifier"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="اسم المستخدم أو رقم الجوال"
            android:background="@drawable/bg_input_exact"
            android:paddingStart="16dp"
            android:paddingEnd="42dp"
            android:inputType="text"
            android:drawableStart="@android:drawable/ic_dialog_email"
            android:drawableTint="@color/theme_header_mid"
            android:drawablePadding="8dp"
            android:textColor="@color/theme_header_deep"
            android:textColorHint="#9AAFC4"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="كلمة المرور"
                android:background="@drawable/bg_input_exact"
                android:paddingStart="16dp"
                android:paddingEnd="42dp"
                android:inputType="textPassword"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawableTint="@color/theme_header_mid"
                android:drawablePadding="8dp"
                android:textColor="@color/theme_header_deep"
                android:textColorHint="#9AAFC4"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivEye"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="إظهار كلمة المرور" />
        </FrameLayout>

        <CheckBox
            android:id="@+id/cbRemember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حفظ بيانات الدخول"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="دخول"
            android:textColor="@color/theme_header_deep"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_gold" />

        <Button
            android:id="@+id/btnBiometric"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="الدخول بالبصمة"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/white"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أو"
            android:textColor="@color/text_gray_light"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إنشاء حساب جديد"
            android:textColor="@color/gold_light"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تصميم وبرمجة"
                android:textColor="@color/text_gray_light"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="م/احمد حسين محسون"
                android:textColor="@color/text_gray_light"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="771421919-734840710"
                android:textColor="@color/text_blue_light"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
