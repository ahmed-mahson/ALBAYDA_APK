<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FC"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:background="@drawable/bg_theme_header"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivLogoHeader"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_court_logo"
            android:contentDescription="@string/logo_desc"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تقنية معلومات محكمة البيضاء الابتدائية"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مرحباً بك"
                android:textColor="@color/teable_gold_start"
                android:textSize="12sp"
                android:layout_marginTop="1dp"
                android:gravity="start" />
        </LinearLayout>


    </LinearLayout>

    <!-- News ticker -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/ref_ticker_bar">

        <com.albayda.court.util.NewsTicker
            android:id="@+id/newsTicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="110dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="none" />

        <TextView
            android:id="@+id/tvNewsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="آخر الأخبار" />
    </FrameLayout>

    <!-- Main content - no scroll, fits screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/ref_services_header"
            android:contentDescription="الخدمات الإلكترونية" />

        <!-- Grid matches the reference screenshot exactly:
             Row 0: الاستعلام عن قضية (left) | الاستعلام عن الجلسات اليومية (right)
             Row 1: إنشاء إعلان حضور (left) | الاستعلام عن القضايا بالمحكمة العليا (right)
             Row 2: (empty left) | منشورات وإعلانات المحكمة (right, shorter card) -->
        <GridLayout
            android:id="@+id/servicesGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:columnCount="2"
            android:rowCount="3"
            android:useDefaultMargins="false">

            <FrameLayout
                android:id="@+id/cardSessions"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_card_height"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ref_btn_sessions"
                    android:contentDescription="الاستعلام عن الجلسات اليومية" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/cardCase"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_card_height"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ref_btn_case"
                    android:contentDescription="الاستعلام عن قضية" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/cardSupreme"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_card_tall_height"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ref_btn_supreme"
                    android:contentDescription="الاستعلام عن القضايا بالمحكمة العليا" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/cardAttendance"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_card_tall_height"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ref_btn_attendance"
                    android:contentDescription="إنشاء إعلان حضور" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/cardPosts"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_card_short_height"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ref_btn_posts"
                    android:contentDescription="منشورات واعلانات المحكمة" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/home_card_short_height"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="3dp" />
        </GridLayout>

        <!-- Keeps the grid at artwork size and absorbs remaining vertical space. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/tvWhatsapp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_whatsapp"
                android:contentDescription="واتساب"
                android:padding="2dp" />

            <ImageView
                android:id="@+id/tvTelegram"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_telegram"
                android:contentDescription="تيليجرام"
                android:padding="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تصميم وبرمجة"
                android:textColor="@color/teable_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="م/احمد حسين محسون"
                android:textColor="@color/teable_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFooterCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="771421919-734840710"
                android:textColor="@color/teable_link"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom nav -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/ivBottomBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/ref_bottom_bar"
            android:contentDescription="شريط التنقل السفلي" />

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:background="@android:color/transparent"
            android:weightSum="3">

            <LinearLayout android:id="@+id/navAdmin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" />
            <LinearLayout android:id="@+id/navAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" />
            <LinearLayout android:id="@+id/navLogout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
