<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ScreenBg"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <!-- Top header card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="6dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">

            <ImageView
                android:id="@+id/ivLogoHeader"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/logo_court"
                android:contentDescription="@string/logo_desc"
                android:scaleType="fitCenter"
                android:elevation="8dp"
                android:outlineAmbientShadowColor="#D4AF37"
                android:outlineSpotShadowColor="#D4AF37" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تقنية معلومات\nمحكمة البيضاء الابتدائية"
                    android:textColor="#D4AF37"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center"
                    android:shadowColor="#80D4AF37"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مرحباً بك"
                    android:textColor="@color/IconBlue"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- News ticker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:background="@drawable/bg_ticker_bg"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/tvNewsTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_news_label"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="آخر الأخبار"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <com.albayda.court.util.NewsTicker
                    android:id="@+id/newsTicker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="none" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <GridLayout
            android:id="@+id/servicesGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="2"
            android:rowCount="3"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/cardCase"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_card_theme"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_search_doc" android:scaleType="fitCenter" android:contentDescription="الاستعلام عن قضية" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="الاستعلام\nعن قضية" android:textColor="@color/NavyText" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSessions"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_card_theme"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_calendar" android:scaleType="fitCenter" android:contentDescription="الاستعلام عن الجلسات اليومية" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="الاستعلام عن\nالجلسات اليومية" android:textColor="@color/NavyText" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAttendance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_card_theme"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_doc_add" android:scaleType="fitCenter" android:contentDescription="إنشاء إعلان حضور" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="إنشاء\nإعلان حضور" android:textColor="@color/NavyText" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSupreme"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_card_theme"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_court" android:scaleType="fitCenter" android:contentDescription="الاستعلام عن القضايا بالمحكمة العليا" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="الاستعلام عن القضايا\nبالمحكمة العليا" android:textColor="@color/NavyText" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPosts"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_card_theme"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_posts" android:scaleType="fitCenter" android:contentDescription="منشورات واعلانات المحكمة" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="منشورات وإعلانات\nالمحكمة" android:textColor="@color/NavyText" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تصميم وبرمجة"
            android:textColor="@color/NavyText"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المهندس/احمد حسين محسون"
            android:textColor="@color/NavyText"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="771421919-7374840710"
            android:textColor="@color/NavyText"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layoutDirection="ltr" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/tvWhatsapp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_whatsapp"
                android:contentDescription="واتساب"
                android:padding="2dp" />

            <ImageView
                android:id="@+id/tvTelegram"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_telegram"
                android:contentDescription="تيليجرام"
                android:padding="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation (white, IconBlue, as per theme) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:background="@color/white"
        android:elevation="8dp"
        android:weightSum="3">

        <LinearLayout android:id="@+id/navAdmin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/HeaderTeal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الإدارة" android:textColor="@color/HeaderTeal" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navAccount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/HeaderTeal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حسابي" android:textColor="@color/HeaderTeal" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navLogout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_lock_power_off" app:tint="@color/HeaderTeal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="خروج" android:textColor="@color/HeaderTeal" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>