<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <!-- قلعة البيضاء بلا خلفية، بلون داكن كما في صورة الترحيب -->
    <ImageView
        android:id="@+id/iv_castle_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.9"
        android:contentDescription="@string/castle_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/castle_cutout_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.40"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- الشعار بتوهج ينبض -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.14"
        app:layout_constraintWidth_percent="0.62">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animation="@anim/logo_pulse"
            android:background="@drawable/bg_logo_glow" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animation="@anim/logo_pulse"
            android:contentDescription="@string/logo_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_court_logo" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_court_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:shadowColor="#B0000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="7"
        android:text="محكمة البيضاء الابتدائية"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.46" />

    <LinearLayout
        android:id="@+id/ll_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.965">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تصميم وبرمجة"
            android:textColor="@color/text_gray_light"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="م/احمد حسين محسون"
            android:textColor="@color/text_gray_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="771421919-734840710"
            android:textColor="@color/text_blue_light"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
