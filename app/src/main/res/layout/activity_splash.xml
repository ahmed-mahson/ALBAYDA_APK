<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/teable_page_bg"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    android:padding="24dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="220dp"
        android:layout_height="220dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animation="@anim/logo_pulse"
            android:background="@drawable/bg_logo_glow" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animation="@anim/logo_pulse"
            android:contentDescription="@string/logo_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_court_logo" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_court_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/court_title"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="تقنية معلومات محكمة البيضاء الابتدائية"
        android:textColor="@color/teable_input_hint"
        android:textSize="13sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/ll_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_dev_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_label"
            android:textColor="@color/teable_input_hint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_dev_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dev_name"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dev_phones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dev_phones"
            android:textColor="@color/text_blue_light"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
