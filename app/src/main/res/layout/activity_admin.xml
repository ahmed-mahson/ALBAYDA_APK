<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="لوحة مدير النظام"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/navy_700" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="المستخدمون بانتظار الموافقة"
        android:textSize="16sp"
        android:textColor="@color/text_blue"
        android:layout_marginTop="16dp" />

    <ListView
        android:id="@+id/lvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إضافة خبر للشريط الإخباري"
        android:textSize="16sp"
        android:textColor="@color/text_blue"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etNews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="نص الخبر"
        android:inputType="textMultiLine"
        android:minLines="2" />

    <Button
        android:id="@+id/btnAddNews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة الخبر"
        android:backgroundTint="@color/gold"
        android:textColor="@color/navy_900"
        android:textStyle="bold" />
</LinearLayout>