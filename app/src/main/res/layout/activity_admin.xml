<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_900"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لوحة إدارة النظام"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشريط الإخباري والتنبيهات"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/etNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اكتب الخبر/التنبيه"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/btnAddNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تحديث الشريط الإخباري"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/gold"
                android:textColor="@color/navy_900" />

            <TextView
                android:id="@+id/tvPendingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تنبيهات المستخدمين الجدد (بانتظار الموافقة)"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />
            <ListView
                android:id="@+id/lvPending"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:dividerHeight="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سجل المستخدمين والإجراءات"
                android:textStyle="bold"
                android:textColor="@color/navy_700"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />
            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:background="@color/white"
                android:padding="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
